# Existing Prediction Microservice API Base URL
PREDICTION_API_URL=http://127.0.0.1:8000
CONFIDENCE_THRESHOLD=0.60

# Database Connection (SQLite default, PostgreSQL compatible)
DATABASE_URL=sqlite:///./agrirakshak.db

# OpenWeatherMap API Key
OPENWEATHER_API_KEY=your_openweather_api_key_here

# LLM API Key (OpenAI / Anthropic)
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here

# JWT Secret Key
SECRET_KEY=agrirakshak-secret-key-change-in-production
